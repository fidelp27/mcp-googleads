# Google Ads MCP Environment Configuration
# Copy this file to .env and fill in your actual values

# Authentication Type (choose one: "oauth" or "service_account")
GOOGLE_ADS_AUTH_TYPE=oauth

# Credentials Path
# For OAuth: Path to client_secret.json or saved token file
# For Service Account: Path to service account key file
GOOGLE_ADS_CREDENTIALS_PATH=/path/to/credentials.json

# OAuth only: token storage path. Keep this separate from client_secret.json.
GOOGLE_ADS_TOKEN_PATH=/path/to/google_ads_token.json

# Google Ads Developer Token (required)
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here

# Manager Account ID (optional, for MCC accounts)
# Format: XXX-XXX-XXXX or XXXXXXXXXX
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# For OAuth-specific config (required if using OAuth and there's no client_secret.json)
GOOGLE_ADS_CLIENT_ID=your_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_client_secret_here

# For Service Account-specific config (optional)
# Email to impersonate with the service account (typically your admin email)
GOOGLE_ADS_IMPERSONATION_EMAIL=

# Network behavior
GOOGLE_ADS_HTTP_TIMEOUT_SECONDS=30
GOOGLE_ADS_API_VERSION=v25

# MCP transport
# Claude Desktop uses stdio. ChatGPT uses a remote Streamable HTTP endpoint.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Agency identity and local state
OPERATOR_NAME=your_name
GOOGLE_ADS_DATA_DIR=./data
GOOGLE_ADS_CONFIG_DIR=./config

# Mandatory write guardrails
# Keep true until write access is intentionally enabled.
READ_ONLY_MODE=true
# Include the MCC and every client account that this instance may access.
ALLOWED_CUSTOMER_IDS=1234567890,0987654321
# Optional comma-separated MCP tools disabled for this operator.
BLOCKED_TOOLS=

# Economic limits. Micros use the account currency (1,000,000 = 1 currency unit).
MAX_DAILY_BUDGET_INCREASE_MICROS=50000000
# Legacy alias interpreted as account-currency units; prefer the micros variable above.
MAX_DAILY_BUDGET_INCREASE_USD=0
MAX_BUDGET_INCREASE_PCT=100
MAX_BID_MICROS=10000000

# Governance
GOOGLE_ADS_RATE_LIMIT_PER_MINUTE=60
APPROVAL_TTL_MINUTES=60
CLIENT_APPROVAL_REQUIRED=false
AUDIT_RETENTION_DAYS=365
